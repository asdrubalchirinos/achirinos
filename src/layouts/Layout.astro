---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import {
    DEFAULT_OG_IMAGE,
    OG_IMAGE_HEIGHT,
    OG_IMAGE_WIDTH,
    SITE_NAME,
    THEME_COLOR,
    TWITTER_HANDLE,
    personJsonLd,
} from "../seo";

interface Props {
    title?: string;
    description?: string;
    lang?: string;
    image?: string;
    imageAlt?: string;
}

const defaultDescription = {
    en: "Vision Architect. I connect dreamers and doers to turn bold ideas into reality.",
    es: "Arquitecto de Visión. Conecto a quienes sueñan con quienes hacen para convertir ideas audaces en realidad.",
};

const {
    title = SITE_NAME,
    description,
    lang = "en",
    image = DEFAULT_OG_IMAGE,
    imageAlt,
} = Astro.props;

const pageLang = lang === "es" ? "es" : "en";
const pageDescription = description ?? defaultDescription[pageLang];

// Home stays "Asdrúbal Chirinos". Other pages become "Filosofía | Asdrúbal Chirinos",
// never "Filosofía | Filosofía".
const pageTitle =
    title === SITE_NAME || title.includes(SITE_NAME)
        ? title
        : `${title} | ${SITE_NAME}`;

const socialImageURL = new URL(image, Astro.site);
const socialImageAlt = imageAlt ?? pageTitle;
const usesDefaultImage = image === DEFAULT_OG_IMAGE;
const imageWidth = usesDefaultImage ? 1024 : OG_IMAGE_WIDTH;
const imageHeight = usesDefaultImage ? 1024 : OG_IMAGE_HEIGHT;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogLocale = pageLang === "es" ? "es_MX" : "en_US";
---

<!doctype html>
<html lang={pageLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="canonical" href={canonicalURL} />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content={THEME_COLOR} />

        <!-- Primary Meta Tags -->
        <title>{pageTitle}</title>
        <meta name="title" content={pageTitle} />
        <meta name="description" content={pageDescription} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:image:width" content={String(imageWidth)} />
        <meta property="og:image:height" content={String(imageHeight)} />
        <meta property="og:image:alt" content={socialImageAlt} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:locale" content={ogLocale} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={socialImageURL} />
        <meta name="twitter:creator" content={TWITTER_HANDLE} />
        <meta name="twitter:site" content={TWITTER_HANDLE} />

        <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

        <!-- Analytics -->
        <script
            data-goatcounter="https://achirinos.goatcounter.com/count"
            async
            src="//gc.zgo.at/count.js"></script>
    </head>
    <body
        class="bg-gray-50 dark:bg-black text-gray-900 dark:text-gray-100 antialiased max-w-2xl mb-40 flex flex-col md:flex-row mx-4 mt-8 lg:mx-auto"
    >
        <main class="flex-auto min-w-0 mt-6 flex flex-col px-2 md:px-0">
            <Header lang={pageLang} />
            <slot />
            <Footer lang={pageLang} />
        </main>
    </body>
</html>
